{
  "name": "qiguang",
  "version": "0.5.20",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "serve": "npm run build && node --env-file-if-exists=.env --experimental-strip-types server.mjs",
    "eval:ai": "node --experimental-strip-types scripts/ai-eval.mjs",
    "test:e2e": "npm run build && node --test --test-concurrency=1 test/browser.e2e.mjs",
    "check:release": "node scripts/release-check.mjs",
    "check:server": "node --experimental-strip-types --check server.mjs",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "check": "npm run test && npm run build && npm run check:server"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "playwright-core": "^1.54.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
