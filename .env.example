# 个人自用 Android 版：Gradle 将密钥写入原生 BuildConfig，网页 JS 不读取；真实值只放本机 .env。
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3
MINIMAX_API_URL=https://api.minimaxi.com/v1/chat/completions
# 可选旧代理模式；个人直连不需要填写。
VITE_API_ORIGIN=
QIGUANG_APP_ORIGIN=
# 真实模型验收时指向已部署服务的 /api/analyze；不用时留空并执行离线评估。
QIGUANG_AI_EVAL_URL=
# 仅当部署层额外要求 Bearer 认证时填写；栖光服务本身不读取此值。
QIGUANG_AI_EVAL_TOKEN=
HOST=127.0.0.1
PORT=4173
