# Android 构建时公开写入的 HTTPS 服务地址，不是密钥；网页同源部署可留空。
VITE_API_ORIGIN=
# 远程服务仅在明确配置后允许栖光 Android WebView 来源（通常为 https://localhost）。
QIGUANG_APP_ORIGIN=
# 以下仅由服务端读取；不要把真实密钥提交到仓库。
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_API_URL=https://api.minimaxi.com/v1/chat/completions
HOST=127.0.0.1
PORT=4173
